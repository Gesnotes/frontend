# Racine de l'API backend (sans slash final).
VITE_API_BASE_URL=http://localhost:3000

# Sous-domaine de l'école, envoyé via l'en-tête X-School-Subdomain.
# Nécessaire en développement : le backend ne résout aucune école depuis
# "localhost" et répondrait 404 sur toutes les routes.
# En production, le sous-domaine du nom d'hôte fait foi — laisser vide.
VITE_SCHOOL_SUBDOMAIN=ecole-demo
