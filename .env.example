# ---------------------------------------------------------------- API
# Racine de l'API backend (sans slash final).
VITE_API_BASE_URL=http://localhost:3000

# Sous-domaine de l'école, envoyé via l'en-tête X-School-Subdomain.
# Nécessaire en développement : le backend ne résout aucune école depuis
# "localhost" et répondrait 404 sur toutes les routes.
# En production, le sous-domaine du nom d'hôte fait foi — laisser vide.
#   seed de base : ecole-demo      (npm run prisma:seed)
#   seed complet : ecole-lumiere   (npm run prisma:seed:demo)
VITE_SCHOOL_SUBDOMAIN=ecole-lumiere

# ------------------------------------------------- Notifications push
# Tout ce bloc est FACULTATIF. Sans lui, l'application fonctionne
# normalement : seules les notifications sont désactivées, et l'écran
# Alertes l'explique au parent.
#
# Console Firebase > Paramètres du projet > Général > Vos applications
#   > Application Web  (créez-en une si nécessaire)
# Ces valeurs sont publiques : elles identifient le projet et ne permettent
# pas d'envoyer. La clé privée d'envoi vit côté backend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Console Firebase > Paramètres du projet > Cloud Messaging
#   > Certificats Web Push > Paire de clés  →  copier la clé publique.
# C'est bien la clé VAPID attendue ici.
VITE_FIREBASE_VAPID_KEY=
