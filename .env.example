# ================================================================== API
# En développement, NE RIEN RENSEIGNER ICI : le proxy de Vite relaie
# /api vers le backend (voir vite.config.ts). Même origine, donc pas de
# CORS, et l'application reste joignable depuis un téléphone ou un
# tunnel HTTPS — indispensable pour essayer la PWA sur un vrai appareil.
#
# Cible du proxy si le backend n'écoute pas sur le port 3000 :
# VITE_API_PROXY_TARGET=http://localhost:3000
#
# En production, à renseigner seulement si l'API n'est pas exposée sous
# /api sur le même domaine :
# VITE_API_BASE_URL=https://api.gesnotes.app

# ------------------------------------------------------------- École
# À LAISSER VIDE en développement.
#
# Le backend sait déjà quelle école utiliser : son DEFAULT_SCHOOL_SUBDOMAIN,
# ou la seule école présente en base. Renseigner cette variable crée une
# seconde source de vérité : deux fichiers .env non versionnés qui divergent
# produisent un « Identifiants invalides » sur des identifiants corrects.
#
# À remplir uniquement pour viser volontairement une école parmi plusieurs.
# En production, le sous-domaine du nom d'hôte fait autorité.
VITE_SCHOOL_SUBDOMAIN=

# --------------------------------- Démonstration publique (vitrine)
# FACULTATIF. Sans lui, le bouton « Voir une démo » n'apparaît pas sur la
# vitrine. Renseignez les quatre valeurs pour pointer vers une école de
# démonstration réelle (ex. le seed `npm run prisma:seed:demo` du backend).
# Le mot de passe est un identifiant public assumé, jamais celui d'une
# vraie école.
VITE_DEMO_SUBDOMAIN=
VITE_DEMO_SCHOOL_NAME=
VITE_DEMO_IDENTIFIER=
VITE_DEMO_PASSWORD=

# ================================================= Notifications push
# Bloc FACULTATIF. Sans lui, l'application fonctionne normalement :
# seules les notifications sont désactivées, et l'écran Alertes l'explique.
# Marche à suivre complète : docs/PWA-PUSH.md
#
# Console Firebase > Paramètres du projet > Général > Vos applications > Web
# Valeurs publiques : elles identifient le projet et ne permettent pas
# d'envoyer. La clé privée d'envoi vit côté backend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Console Firebase > Paramètres du projet > Cloud Messaging
#   > Certificats Web Push > Paire de clés  →  copier la clé publique.
VITE_FIREBASE_VAPID_KEY=

# ================================================== Suivi des erreurs
# GlitchTip (ou tout serveur compatible Sentry). Vide = desactive.
#
# Le serveur se lance depuis le backend :
#   cd backend && docker compose -f docker-compose.glitchtip.yml up -d
# Puis http://localhost:8000, creer le projet "gesnotes-frontend"
# et copier son DSN ici. Marche a suivre : backend/docs/MONITORING.md
VITE_SENTRY_DSN=

# Etiquette affichee dans le tableau de bord (defaut : mode Vite).
VITE_SENTRY_ENVIRONMENT=
